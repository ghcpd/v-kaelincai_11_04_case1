[
  {
    "id": "test_01_normal",
    "description": "Valid user request with proper authentication",
    "input": {
      "endpoint": "/user",
      "method": "GET",
      "headers": {"Authorization": "Bearer valid_token_123"},
      "params": {"user_id": "12345"}
    },
    "expected_status": 200,
    "expected_output": {
      "status": "success",
      "data": {
        "user_id": "12345",
        "name": "John Doe",
        "email": "john@example.com"
      }
    }
  },
  {
    "id": "test_02_boundary",
    "description": "Large payload with deeply nested JSON",
    "input": {
      "endpoint": "/user",
      "method": "POST",
      "headers": {"Authorization": "Bearer valid_token_123", "Content-Type": "application/json"},
      "body": {
        "user_id": "99999",
        "metadata": {
          "preferences": {
            "notifications": {"email": true, "sms": false, "push": true},
            "privacy": {"public_profile": true, "show_email": false}
          }
        }
      }
    },
    "expected_status": 200,
    "expected_output": {"status": "success"}
  },
  {
    "id": "test_03_invalid_auth",
    "description": "Request with missing or invalid authentication token",
    "input": {
      "endpoint": "/user",
      "method": "GET",
      "headers": {"Authorization": "Bearer invalid_token"},
      "params": {"user_id": "12345"}
    },
    "expected_status": 401,
    "expected_output": {"status": "error", "message": "Unauthorized"}
  },
  {
    "id": "test_04_malformed",
    "description": "Malformed request with missing required fields",
    "input": {
      "endpoint": "/user",
      "method": "POST",
      "headers": {"Authorization": "Bearer valid_token_123"},
      "body": {"invalid_field": "value"}
    },
    "expected_status": 400,
    "expected_output": {"status": "error", "message": "Bad Request"}
  },
  {
    "id": "test_05_compatibility",
    "description": "Mixed format request testing backward compatibility",
    "input": {
      "endpoint": "/user",
      "method": "GET",
      "headers": {"Authorization": "Bearer valid_token_123", "API-Version": "v1"},
      "params": {"userId": "12345", "include_legacy": "true"}
    },
    "expected_status": 200,
    "expected_output": {"status": "success"}
  }
]
