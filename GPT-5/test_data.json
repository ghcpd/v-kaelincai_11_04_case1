[
  {
    "id": 1,
    "description": "Valid v2 profile request",
    "path": "/v2/profile",
    "payload": {"id": 10, "name": "Alice", "email": "alice@example.com"},
    "headers": {"Authorization": "token-new"},
    "expected_status": 200,
    "expected_pass": true,
    "expected_output_contains": ["status", "data", "meta"]
  },
  {
    "id": 2,
    "description": "Legacy endpoint with legacy Accept",
    "path": "/v1/user",
    "payload": {"id": 11, "name": "Bob", "email": "bob@example.com"},
    "headers": {"Authorization": "token-123", "Accept": "application/vnd.legacy+json"},
    "expected_status": 200,
    "expected_pass": true,
    "expected_output_contains": ["id", "name", "latency_ms"]
  },
  {
    "id": 3,
    "description": "Missing auth token",
    "path": "/v2/profile",
    "payload": {"id": 12, "name": "Charlie"},
    "headers": {},
    "expected_status": 401,
    "expected_pass": true,
    "expected_output_contains": ["error"]
  },
  {
    "id": 4,
    "description": "Large nested payload",
    "path": "/v2/profile",
    "payload": {"id": 13, "name": "Diana", "nested": {"a": {"b": {"c": {"d": {"e": 1}}}}}, "preferences": {"theme": "dark", "notifications": {"email": true, "sms": false}}},
    "headers": {"Authorization": "token-new"},
    "expected_status": 200,
    "expected_pass": true,
    "expected_output_contains": ["nested", "preferences"]
  },
  {
    "id": 5,
    "description": "Missing required field name",
    "path": "/v2/profile",
    "payload": {"id": 14, "email": "no-name@example.com"},
    "headers": {"Authorization": "token-new"},
    "expected_status": 400,
    "expected_pass": true,
    "expected_output_contains": ["error"]
  }
]