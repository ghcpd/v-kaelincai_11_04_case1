[
  {
    "id": "case-001",
    "description": "Standard profile lookup using v2 endpoint with history",
    "input": {
      "endpoint": "/v2/profile",
      "payload": {
        "userId": "usr-1001",
        "token": "rotating-service-token",
        "includeHistory": true,
        "historyDepth": 2
      }
    },
    "expected_status": 200,
    "expected_output": {
      "payload.profile.id": "usr-1001",
      "payload.profile.activity.history_length": 2
    },
    "expected_outcome": "pass"
  },
  {
    "id": "case-002",
    "description": "Legacy endpoint request that must be migrated to v2 schema",
    "input": {
      "endpoint": "/v1/user",
      "payload": {
        "userId": "usr-1002",
        "token": "legacy-static-token",
        "includeHistory": "false"
      }
    },
    "expected_status": 200,
    "expected_output": {
      "payload.user.first_name": "Colin",
      "meta.schemaVersion": "legacy-1"
    },
    "expected_outcome": "fail" 
  },
  {
    "id": "case-003",
    "description": "Boundary: deeply nested history with pagination depth",
    "input": {
      "endpoint": "/v2/profile",
      "payload": {
        "userId": "usr-1001",
        "token": "rotating-service-token",
        "includeHistory": true,
        "historyDepth": 25
      }
    },
    "expected_status": 200,
    "expected_output": {
      "payload.profile.activity.history_length": 3
    },
    "expected_outcome": "pass"
  },
  {
    "id": "case-004",
    "description": "Malformed payload missing token",
    "input": {
      "endpoint": "/v2/profile",
      "payload": {
        "userId": "usr-1001"
      }
    },
    "expected_status": 401,
    "expected_output": {
      "payload.error.message": "Missing or invalid authentication token"
    },
    "expected_outcome": "fail"
  },
  {
    "id": "case-005",
    "description": "Compatibility redirect from v1 to v2 with mixed schema",
    "input": {
      "endpoint": "/v1/user",
      "payload": {
        "userId": "usr-404",
        "token": "legacy-static-token",
        "includeHistory": "true",
        "historyDepth": 2
      }
    },
    "expected_status": 404,
    "expected_output": {
      "payload.errorMessage": "user not found"
    },
    "expected_outcome": "fail"
  }
]
