      "payload": {
        "profile": {"locale": "en-US", "tags": ["loyal", "beta"], "nested": {"depth": 6}},
        "pagination": {"cursor": "ZXhhbXBsZQ==", "limit": 200}
      }
    },
    "expected_status": 200,
    "expected_output": {
      "activity": {"session_count": 2}
    },
    "expected_outcome": "pass"
  },
  {
    "name": "invalid_token_rejected",
    "input": {"user_id": "1001", "token": "tampered"},
